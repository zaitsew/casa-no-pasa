# Copy to .env. Nothing here is required: without the hub variables the AI is off and the
# engine extracts with rules and drafts from templates.

# The accounts hub host and this product's service token (the hub meters the model calls).
ACCOUNTS_URL=
ACCOUNTS_SERVICE_CASANOPASA=
# "off" is the kill switch: the engine stays up, with templates only.
CASANOPASA_AI=

# SQLite file. Default: ./data/casanopasa.db
CASANOPASA_DB_PATH=

# AES-256-GCM key for dossier documents (generate with: openssl rand -hex 32). Empty = documents and dossier links off.
CASANOPASA_FILES_KEY=
# Where encrypted documents are stored. Default: ./data/files
CASANOPASA_FILES_DIR=

# The Telegram bot (create it with @BotFather). Empty token = the webhook cannot talk to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string (openssl rand -hex 24). Telegram sends it in a header; requests without it are refused.
TELEGRAM_WEBHOOK_SECRET=
# The public https URL of this app (dossier links and the webhook are built from it).
CASANOPASA_PUBLIC_URL=
# Shared secret of the Cloudflare Email Worker (openssl rand -hex 24). Empty = alert email off.
CASANOPASA_INBOUND_SECRET=
# Optional: the domain of per-renter alert addresses. Default: in.casanopasa.fabriquefutur.com
CASANOPASA_INBOUND_DOMAIN=
