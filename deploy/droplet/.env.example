# Rendered to /srv/casanopasa/.env on the server (mode 600) the first time only.
# Fill the values below, then: cd /srv && docker compose up -d casanopasa

# From @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string: openssl rand -hex 24. The same value goes in your laptop .env for `npm run telegram-setup`.
TELEGRAM_WEBHOOK_SECRET=
CASANOPASA_PUBLIC_URL=https://casanopasa.fabriquefutur.com
# AES-256-GCM key for documents: openssl rand -hex 32. Lose it and every stored document is unreadable.
CASANOPASA_FILES_KEY=
# Shared secret between the inbound-mail receiver (casanopasa-mx) and the app (openssl rand -hex 24). Empty = alert email off.
CASANOPASA_INBOUND_SECRET=

# Optional: the accounts hub (AI). Empty = rules and templates only.
# ACCOUNTS_URL=
# ACCOUNTS_SERVICE_CASANOPASA=
